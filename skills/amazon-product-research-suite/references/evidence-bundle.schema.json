{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PDBen-Auto/amazon-product-research-agent-skills/blob/main/skills/amazon-product-research-suite/references/evidence-bundle.schema.json",
  "title": "Amazon Product Research Evidence Bundle",
  "type": "object",
  "required": ["schema_version", "bundle_id", "product", "scope", "evidence", "assumptions", "blockers"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_id": {"type": "string", "minLength": 1},
    "product": {"type": "object", "required": ["name"]},
    "scope": {"type": "object", "required": ["marketplace", "as_of"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "claim", "kind", "source", "confidence"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "kind": {"enum": ["observed", "calculated", "modeled", "inferred", "assumed"]},
          "source": {"type": "object", "required": ["type", "locator", "accessed_at"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "coverage": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
        }
      }
    },
    "assumptions": {"type": "array"},
    "blockers": {"type": "array"}
  },
  "additionalProperties": true
}
